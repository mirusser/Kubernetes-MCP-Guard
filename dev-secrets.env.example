# dev-secrets.env.example — template for local developer secrets.
#
# Copy to dev-secrets.env (gitignored via *.env) and fill in real values:
#   cp dev-secrets.env.example dev-secrets.env
#
# scripts/generate-env.sh and scripts/quickstart.sh auto-source dev-secrets.env
# from the repo root if it exists, so these no longer need to be `export`ed by
# hand in every new shell. Values here never get committed or copied into the
# generated Compose env files' git history — generate-env.sh still only
# writes them into the gitignored deploy/generated/*.env output.

# Required for the source-build stack (Observer and Planner call OpenRouter).
InfraGate__OpenRouter__ApiKey=

# Optional: only needed if the downstream/agent Keycloak clients are
# confidential (have a client secret) rather than public.
InfraGate__DownstreamAuth__GatewayClientSecret=
InfraGate__Observer__ClientCredentials__ClientSecret=
InfraGate__Planner__ClientCredentials__ClientSecret=
InfraGate__Executor__ClientCredentials__ClientSecret=
