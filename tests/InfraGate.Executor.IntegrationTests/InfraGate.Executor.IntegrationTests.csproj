      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="InfraGate.Executor.Settings" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InfraGate.Executor\InfraGate.Executor.csproj" />
    <ProjectReference Include="..\..\src\InfraGate.Remediation.Contracts\InfraGate.Remediation.Contracts.csproj" />
    <ProjectReference Include="..\..\src\InfraGate.ClientCredentials\InfraGate.ClientCredentials.csproj" />
