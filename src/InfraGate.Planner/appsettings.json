{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "InfraGate": "Debug"
    }
  },
  "InfraGate": {
    "Planner": {
      "ClientCredentials": {
        "ClientId": "infra-gate-planner",
        "Scope": "mcp:tools.propose mcp:tools.readonly",
        "RequireHttpsMetadata": false
      }
    }
  }
}
