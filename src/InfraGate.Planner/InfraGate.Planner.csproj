<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InfraGate.Planner.Tests" />
    <InternalsVisibleTo Include="InfraGate.Planner.IntegrationTests" />
    <InternalsVisibleTo Include="InfraGate.Remediation.E2E.Tests" />
    <InternalsVisibleTo Include="InfraGate.Safety.E2E.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.8.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.8.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Migrations\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Prompts\PlannerSystemPrompt.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfraGate.AgentLlm\InfraGate.AgentLlm.csproj" />
    <ProjectReference Include="..\InfraGate.AuditOutbox\InfraGate.AuditOutbox.csproj" />
    <ProjectReference Include="..\InfraGate.AuditOutbox.Postgres\InfraGate.AuditOutbox.Postgres.csproj" />
    <ProjectReference Include="..\InfraGate.Observer.Contracts\InfraGate.Observer.Contracts.csproj" />
    <ProjectReference Include="..\InfraGate.Remediation.Contracts\InfraGate.Remediation.Contracts.csproj" />
    <ProjectReference Include="..\InfraGate.ClientCredentials\InfraGate.ClientCredentials.csproj" />
    <ProjectReference Include="..\InfraGate.Observability\InfraGate.Observability.csproj" />
    <ProjectReference Include="..\InfraGate.RuntimeSafety\InfraGate.RuntimeSafety.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CanonicalJson.cs" Link="CanonicalJson.cs" />
  </ItemGroup>
</Project>
