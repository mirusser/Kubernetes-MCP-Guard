{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "InfraGate": "Debug"
    }
  },
  "InfraGate": {
    "Observer": {
      "ClientCredentials": {
        "ClientId": "infra-gate-observer",
        "Scope": "mcp:tools.readonly",
        "RequireHttpsMetadata": false
      }
    }
  }
}
