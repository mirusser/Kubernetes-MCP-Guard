    <ProjectReference Include="..\InfraGate.Observer.Contracts\InfraGate.Observer.Contracts.csproj" />
    <ProjectReference Include="..\InfraGate.ClientCredentials\InfraGate.ClientCredentials.csproj" />
    <ProjectReference Include="..\InfraGate.Observability\InfraGate.Observability.csproj" />
    <ProjectReference Include="..\InfraGate.RuntimeSafety\InfraGate.RuntimeSafety.csproj" />
