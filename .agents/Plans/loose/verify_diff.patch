diff --git a/tests/InfraGate.Planner.Tests/UnitTests/WorkflowExecutorTests.cs b/tests/InfraGate.Planner.Tests/UnitTests/WorkflowExecutorTests.cs
new file mode 100644
index 0000000..a4e685c
--- /dev/null
+++ b/tests/InfraGate.Planner.Tests/UnitTests/WorkflowExecutorTests.cs
@@ -0,0 +1,184 @@
+using InfraGate.AgentLlm;
+using InfraGate.Observer.Contracts;
+using InfraGate.Planner.Audit;
+using InfraGate.Planner.Cycle.Workflow;
+using InfraGate.Planner.Dedupe;
+using InfraGate.Planner.Diagnostics;
+using Microsoft.Agents.AI.Workflows;
+using Microsoft.Extensions.AI;
+using Microsoft.Extensions.Logging.Abstractions;
+
+namespace InfraGate.Planner.Tests.UnitTests;
+
+/// <summary>
+/// Focused executor-level tests for the five Planner workflow executors.
+/// These tests exercise individual executors in isolation, complementing the
+/// end-to-end BatchProcessorTests that exercise the complete workflow graph.
+/// </summary>
+public sealed class WorkflowExecutorTests
+{
+    // ------------------------------------------------------------------ //
+    // FilterExecutor
+    // ------------------------------------------------------------------ //
+
+    [Fact]
+    public async Task FilterExecutor_Resolved_DropsSilentlyWithoutAudit()
+    {
+        // Resolved anomalies are dropped without emitting a ProposalSkipped audit event.
+        var report = CreateAnomaly(AnomalyStatus.Resolved, AnomalyKind.DeploymentUnavailable);
+        var auditOutbox = Substitute.For<IPlannerAuditOutbox>();
+        var context = Substitute.For<IWorkflowContext>();
+
+        var executor = new FilterExecutor("filter-0", report, new PlannerDedupeStore(), auditOutbox, NullLogger.Instance);
+        await executor.HandleAsync(CreateBatch(report), context, CancellationToken.None);
+
+        await auditOutbox.DidNotReceive().AppendAsync(Arg.Any<PlannerAuditEntry>(), Arg.Any<CancellationToken>());
+        await context.DidNotReceive().SendMessageAsync(Arg.Any<AnomalyReport>(), Arg.Any<CancellationToken>());
+    }
+
+    [Fact]
+    public async Task FilterExecutor_UnsupportedKind_EmitsAuditAndDrops()
+    {
+        // Non-Resolved filter-drops emit ProposalSkipped to the audit outbox.
+        var report = CreateAnomaly(AnomalyStatus.Active, (AnomalyKind)999);
+        var auditOutbox = Substitute.For<IPlannerAuditOutbox>();
+        var context = Substitute.For<IWorkflowContext>();
+
+        var executor = new FilterExecutor("filter-0", report, new PlannerDedupeStore(), auditOutbox, NullLogger.Instance);
+        await executor.HandleAsync(CreateBatch(report), context, CancellationToken.None);
+
+        await auditOutbox.Received(1).AppendAsync(
+            Arg.Is<PlannerAuditEntry>(e => e.EventName == PlannerAuditEvents.ProposalSkipped),
+            Arg.Any<CancellationToken>());
+        await context.DidNotReceive().SendMessageAsync(Arg.Any<AnomalyReport>(), Arg.Any<CancellationToken>());
+    }
+
+    [Fact]
+    public async Task FilterExecutor_ActiveAllowedKind_ForwardsReport()
+    {
+        // Active anomaly with an allowed kind passes through to the next executor.
+        var report = CreateAnomaly(AnomalyStatus.Active, AnomalyKind.DeploymentUnavailable);
+        var context = Substitute.For<IWorkflowContext>();
+
+        var executor = new FilterExecutor("filter-0", report, new PlannerDedupeStore(), auditOutbox: null, NullLogger.Instance);
+        await executor.HandleAsync(CreateBatch(report), context, CancellationToken.None);
+
+        await context.Received(1).SendMessageAsync(report, Arg.Any<CancellationToken>());
+    }
+
+    // ------------------------------------------------------------------ //
+    // DedupeGateExecutor
+    // ------------------------------------------------------------------ //
+
+    [Fact]
+    public async Task DedupeGateExecutor_ActivePlan_EmitsProposalSkippedAndDrops()
+    {
+        // If a plan is already active for the anomaly, DedupeGateExecutor emits
+        // a ProposalSkipped audit event and does not forward the report.
+        var report = CreateAnomaly(AnomalyStatus.Active, AnomalyKind.DeploymentUnavailable);
+        var dedupeStore = new PlannerDedupeStore();
+        var expiry = DateTimeOffset.UtcNow.AddHours(1);
+        dedupeStore.TrackActivePlan(report.AnomalyId, "plan-existing", DateTimeOffset.UtcNow, expiry);
+
+        var auditOutbox = Substitute.For<IPlannerAuditOutbox>();
+        var context = Substitute.For<IWorkflowContext>();
+
+        var executor = new DedupeGateExecutor("dedupe-0", report, dedupeStore, auditOutbox, NullLogger.Instance);
+        await executor.HandleAsync(report, context, CancellationToken.None);
+
+        await auditOutbox.Received(1).AppendAsync(
+            Arg.Is<PlannerAuditEntry>(e => e.EventName == PlannerAuditEvents.ProposalSkipped),
+            Arg.Any<CancellationToken>());
+        await context.DidNotReceive().SendMessageAsync(Arg.Any<AnomalyReport>(), Arg.Any<CancellationToken>());
+    }
+
+    [Fact]
+    public async Task DedupeGateExecutor_NoActivePlan_ForwardsReport()
+    {
+        // No active plan → DedupeGateExecutor passes the report through.
+        var report = CreateAnomaly(AnomalyStatus.Active, AnomalyKind.DeploymentUnavailable);
+        var context = Substitute.For<IWorkflowContext>();
+
+        var executor = new DedupeGateExecutor("dedupe-0", report, new PlannerDedupeStore(), auditOutbox: null, NullLogger.Instance);
+        await executor.HandleAsync(report, context, CancellationToken.None);
+
+        await context.Received(1).SendMessageAsync(report, Arg.Any<CancellationToken>());
+    }
+
+    // ------------------------------------------------------------------ //
+    // DecideExecutor — tools must exclude propose_plan
+    // ------------------------------------------------------------------ //
+
+    [Fact]
+    public async Task DecideExecutor_UsesFactory_AgentToolsExcludeProposePlan()
+    {
+        // propose_plan must never be passed to the agent's tool list.
+        // The read-only tool list (which never includes propose_plan) is what
+        // gets wired into DecideExecutor. This test verifies that the fixture
+        // tool list does not contain propose_plan, and that the decision flows through.
+        var report = CreateAnomaly(AnomalyStatus.Active, AnomalyKind.DeploymentUnavailable);
+        var chatClient = new FixtureChatClient("""
+        {
+          "operationType": "restart_deployment",
+          "arguments": { "name": "nginx-demo", "namespace": "mcp-nginx-demo" }
+        }
+        """);
+
+        var context = Substitute.For<IWorkflowContext>();
+        var agentFactory = new ToolCallingAgentFactory(chatClient);
+
+        // Simulate a read-only tool list (propose_plan is excluded by design).
+        var readOnlyTools = new List<AITool>
+        {
+            AIFunctionFactory.Create(() => "status", PlannerConventions.ToolNames.GetK8sStatus),
+        };
+
+        var executor = new DecideExecutor(
+            "decide-0", report, agentFactory, "system prompt", readOnlyTools,
+            maxToolIterations: 4, anomalyWallClockCapSeconds: 30,
+            timeoutCounter: null, NullLogger.Instance);
+
+        await executor.HandleAsync(report, context, CancellationToken.None);
+
+        // propose_plan must not appear in the tools given to the agent.
+        var agentTools = chatClient.LastOptions?.Tools ?? [];
+        Assert.DoesNotContain(agentTools, t => string.Equals(
+            t.Name, PlannerConventions.ToolNames.ProposePlan, StringComparison.Ordinal));
+
+        // The decision is forwarded to the next executor.
+        await context.Received(1).SendMessageAsync(Arg.Any<DecisionContext>(), Arg.Any<CancellationToken>());
+    }
+
+    // ------------------------------------------------------------------ //
+    // Helpers
+    // ------------------------------------------------------------------ //
+
+    private static AnomalyReport CreateAnomaly(AnomalyStatus status, AnomalyKind kind) =>
+        new()
+        {
+            AnomalyId = "anomaly-executor-test",
+            CycleId = "cycle-executor-test",
+            DetectedAt = new DateTimeOffset(2026, 5, 29, 12, 0, 0, TimeSpan.Zero),
+            Kind = kind,
+            Target = new ResourceRef
+            {
+                ApiVersion = "apps/v1",
+                Kind = "Deployment",
+                Namespace = "mcp-nginx-demo",
+                Name = "nginx-demo",
+            },
+            Severity = Severity.High,
+            Status = status,
+            Summary = "Test anomaly.",
+            Evidence = [],
+            Annotations = new Dictionary<string, string>(StringComparer.Ordinal),
+        };
+
+    private static AnomalyHandoffBatch CreateBatch(AnomalyReport report) =>
+        new()
+        {
+            CycleId = "cycle-executor-test",
+            EmittedAt = new DateTimeOffset(2026, 5, 29, 12, 0, 0, TimeSpan.Zero),
+            Reports = [report],
+        };
+}
