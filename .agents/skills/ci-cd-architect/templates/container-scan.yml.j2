# container-scan.yml - Container Image Vulnerability Scan
#
# Use this template when container scanning is not embedded in publish.yml.
# Substitution variables:
# {{ image_ref }} - image reference to scan, e.g. ghcr.io/org/app:sha

name: Container Scan

on:
  workflow_dispatch:
    inputs:
      image_ref:
        description: Image reference to scan
        required: true
        type: string
  workflow_call:
    inputs:
      image_ref:
        required: true
        type: string

permissions:
  contents: read
  security-events: write

concurrency:
  group: container-scan-${{ inputs.image_ref || github.sha }}
  cancel-in-progress: true

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

jobs:
  trivy:
    runs-on: ubuntu-latest
    steps:
      - name: Scan image for vulnerabilities
        uses: aquasecurity/trivy-action@v0.36.0
        with:
          image-ref: ${{ inputs.image_ref }}
          format: sarif
          output: trivy.sarif
          scanners: vuln
          severity: CRITICAL,HIGH
          ignore-unfixed: true
          exit-code: "1"

      - name: Upload Trivy SARIF results
        if: always() && hashFiles('trivy.sarif') != ''
        uses: github/codeql-action/upload-sarif@v4
        with:
          sarif_file: trivy.sarif
          category: trivy
