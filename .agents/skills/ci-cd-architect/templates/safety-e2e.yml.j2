# safety-e2e.yml - Explicit Opt-in Safety E2E Tests
#
# Substitution variables:
# {{ dotnet_version }}       - .NET SDK version
# {{ safety_test_project }}  - E2E test project path
# {{ kube_ready_command }}   - readiness command for the target cluster

name: Safety E2E Tests

on:
  workflow_dispatch:
    inputs:
      run_safety_e2e:
        description: Confirm that this run may touch live or local Kubernetes infrastructure
        required: true
        type: boolean
        default: false

permissions:
  contents: read

concurrency:
  group: safety-e2e-${{ github.ref }}
  cancel-in-progress: true

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

jobs:
  safety-e2e:
    if: inputs.run_safety_e2e == true
    runs-on: {{ safety_e2e_runner | default("ubuntu-latest") }}
    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Set up .NET
        uses: actions/setup-dotnet@v5
        with:
          dotnet-version: {{ dotnet_version | default("10.0.x") }}

      - name: Install kubectl
        uses: azure/setup-kubectl@v4

      - name: Verify Kubernetes readiness
        run: {{ kube_ready_command | default("kubectl cluster-info && kubectl wait --for=condition=Ready node --all --timeout=120s") }}

      - name: Restore
        run: dotnet restore {{ safety_test_project }}

      - name: Build
        run: dotnet build {{ safety_test_project }} --configuration Release --no-restore

      - name: Run safety E2E tests
        env:
          INFRA_GATE_RUN_SAFETY_E2E: "1"
        run: dotnet test {{ safety_test_project }} --configuration Release --no-build --filter "Category=SafetyE2E" --logger "console;verbosity=normal"
