# dependency-scan.yml - Package Vulnerability Scan
#
# Substitution variables:
# {{ project }}          - project display name
# {{ language }}         - "dotnet", "python", or "polyglot"
# {{ dotnet_solution }}  - solution path when language includes .NET
# {{ dotnet_version }}   - .NET SDK version

name: Dependency Scan

on:
  pull_request:
  push:
    branches: {{ ci_branches | default(["main"]) }}
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: dependency-scan-${{ github.event.pull_request.number || github.sha }}
  cancel-in-progress: true

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

jobs:
  {% if language in ["dotnet", "polyglot"] %}
  nuget-vulnerability-scan:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Set up .NET
        uses: actions/setup-dotnet@v5
        with:
          dotnet-version: {{ dotnet_version | default("10.0.x") }}

      - name: Restore
        run: dotnet restore {{ dotnet_solution }}

      - name: Check NuGet package vulnerabilities
        run: |
          dotnet list {{ dotnet_solution }} package --vulnerable --include-transitive 2>&1 | tee vuln-report.txt
          if grep -q 'Critical\|High' vuln-report.txt; then
            echo "FAIL: Critical or High severity NuGet vulnerabilities found."
            cat vuln-report.txt
            exit 1
          fi

      - name: Check deprecated NuGet packages
        continue-on-error: true
        run: dotnet list {{ dotnet_solution }} package --deprecated --include-transitive 2>&1 | tee deprecated-report.txt

      - name: Upload dependency scan reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: dependency-scan-reports
          path: |
            vuln-report.txt
            deprecated-report.txt
          if-no-files-found: ignore
  {% endif %}
