# Generated from run-profiles.yaml profile: smoke-release
# Do not edit. Run: dotnet run --project src/InfraGate.RunProfiles -- generate smoke-release

# Runtime
InfraGate__Runtime__Environment=Development

# Gateway
InfraGate__Gateway__AspNetCoreUrls=http://0.0.0.0:3001
InfraGate__Gateway__DownstreamAssembly=/app/server/InfraGate.McpServer.dll
InfraGate__Gateway__GuardAuditRoot=/data/guardrails

# Identity Provider
InfraGate__Auth__OAuthAuthority=http://127.0.0.1:3010/realms/infra-gate
InfraGate__Auth__OAuthMetadataAddress=http://keycloak:8080/realms/infra-gate/.well-known/openid-configuration
InfraGate__Auth__OAuthResource=http://127.0.0.1:3001/mcp
InfraGate__Auth__OAuthScope=mcp:tools
InfraGate__Auth__OAuthRequireHttpsMetadata=false

# Approval Authority
InfraGate__Approval__BaseUrl=http://127.0.0.1:3001
InfraGate__Auth__ApprovalOAuthClientId=infra-gate-approval-ui
InfraGate__Auth__ApprovalOAuthCallbackPath=/approvals/oauth/callback
InfraGate__Auth__ApprovalOAuthAuthorizationEndpoint=http://127.0.0.1:3010/realms/infra-gate/protocol/openid-connect/auth
InfraGate__Auth__ApprovalOAuthTokenEndpoint=http://keycloak:8080/realms/infra-gate/protocol/openid-connect/token

# Generic Approval Core
InfraGate__Approval__Root=/data/approvals
InfraGate__Approval__Postgres__ConnectionString=Host=postgres;Port=5432;Database=infra-gate;Username=infra-gate;Password=infra-gate-dev-password
InfraGate__Approval__Postgres__RunMigrationsOnStartup=true

# Downstream Auth
InfraGate__DownstreamAuth__Required=true
InfraGate__DownstreamAuth__Authority=http://keycloak:8080/realms/infra-gate
InfraGate__DownstreamAuth__MetadataAddress=http://keycloak:8080/realms/infra-gate/.well-known/openid-configuration
InfraGate__DownstreamAuth__RequireHttpsMetadata=false
InfraGate__DownstreamAuth__Audience=urn:infra-gate:mcp-server
InfraGate__DownstreamAuth__Scope=mcp:downstream
InfraGate__DownstreamAuth__GatewayClientId=infra-gate-gateway-service
InfraGate__DownstreamAuth__GatewayClientSecret=gateway-service-secret

# Kubernetes Adapter
InfraGate__Kubernetes__KubeConfig=/run/kube/mcp-nginx-demo.compose.config
InfraGate__Kubernetes__AllowedNamespaces__0=mcp-nginx-demo

# Host
INFRA_GATE_BIND_ADDRESS=127.0.0.1
INFRA_GATE_BIND_PORT=3001
INFRA_GATE_GATEWAY_IMAGE=ghcr.io/mirusser/kubernetes-mcp-guard-gateway
INFRA_GATE_KUBECONFIG_HOST_PATH=../../.kube/mcp-nginx-demo.compose.config
INFRA_GATE_APPROVAL_HOST_PATH=../../.mcp-approvals
INFRA_GATE_GUARD_AUDIT_HOST_PATH=../../.mcp-guardrails
INFRA_GATE_DATA_PROTECTION_HOST_PATH=../../.mcp-dataprotection-keys
