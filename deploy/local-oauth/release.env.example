# Generated from run-profiles.yaml profile: smoke-release
# Do not edit. Run: dotnet run --project src/InfraGate.RunProfiles -- generate smoke-release

# Runtime
INFRA_GATE_ENVIRONMENT=Development

# Gateway
ASPNETCORE_URLS=http://0.0.0.0:3001
INFRA_GATE_DOWNSTREAM_ASSEMBLY=/app/server/InfraGate.McpServer.dll
INFRA_GATE_GUARD_AUDIT_ROOT=/data/guardrails

# Identity Provider
INFRA_GATE_OAUTH_AUTHORITY=http://127.0.0.1:3010/realms/infra-gate
INFRA_GATE_OAUTH_METADATA_ADDRESS=http://keycloak:8080/realms/infra-gate/.well-known/openid-configuration
INFRA_GATE_OAUTH_RESOURCE=http://127.0.0.1:3001/mcp
INFRA_GATE_OAUTH_SCOPE=mcp:tools
INFRA_GATE_OAUTH_REQUIRE_HTTPS_METADATA=false

# Approval Authority
INFRA_GATE_APPROVAL_BASE_URL=http://127.0.0.1:3001
INFRA_GATE_APPROVAL_OAUTH_CLIENT_ID=infra-gate-approval-ui
INFRA_GATE_APPROVAL_OAUTH_CALLBACK_PATH=/approvals/oauth/callback
INFRA_GATE_APPROVAL_OAUTH_AUTHORIZATION_ENDPOINT=http://127.0.0.1:3010/realms/infra-gate/protocol/openid-connect/auth
INFRA_GATE_APPROVAL_OAUTH_TOKEN_ENDPOINT=http://keycloak:8080/realms/infra-gate/protocol/openid-connect/token

# Generic Approval Core
K8S_MCP_APPROVAL_ROOT=/data/approvals

# Downstream Auth
INFRA_GATE_DOWNSTREAM_AUTH_REQUIRED=true
INFRA_GATE_DOWNSTREAM_AUTH_AUTHORITY=http://keycloak:8080/realms/infra-gate
INFRA_GATE_DOWNSTREAM_AUTH_METADATA_ADDRESS=http://keycloak:8080/realms/infra-gate/.well-known/openid-configuration
INFRA_GATE_DOWNSTREAM_AUTH_REQUIRE_HTTPS_METADATA=false
INFRA_GATE_DOWNSTREAM_AUTH_AUDIENCE=urn:infra-gate:mcp-server
INFRA_GATE_DOWNSTREAM_AUTH_SCOPE=mcp:downstream
INFRA_GATE_DOWNSTREAM_AUTH_GATEWAY_CLIENT_ID=infra-gate-gateway-service
INFRA_GATE_DOWNSTREAM_AUTH_GATEWAY_CLIENT_SECRET=gateway-service-secret

# Kubernetes Adapter
KUBECONFIG=/run/kube/mcp-nginx-demo.compose.config
K8S_MCP_ALLOWED_NAMESPACES=mcp-nginx-demo

# Host
INFRA_GATE_BIND_ADDRESS=127.0.0.1
INFRA_GATE_BIND_PORT=3001
INFRA_GATE_GATEWAY_IMAGE=ghcr.io/mirusser/kubernetes-mcp-guard-gateway
INFRA_GATE_CONFIG_PATH=/app/config/appsettings.InfraGate.json
INFRA_GATE_CONFIG_HOST_PATH=./release.appsettings.json
INFRA_GATE_KUBECONFIG_HOST_PATH=../../.kube/mcp-nginx-demo.compose.config
INFRA_GATE_APPROVAL_HOST_PATH=../../.mcp-approvals
INFRA_GATE_GUARD_AUDIT_HOST_PATH=../../.mcp-guardrails
INFRA_GATE_DATA_PROTECTION_HOST_PATH=../../.mcp-dataprotection-keys
