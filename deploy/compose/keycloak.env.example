# Keycloak demo environment overrides.
# Copy to keycloak.env and adjust, then run:
#   docker compose -f deploy/compose/keycloak.yaml --env-file deploy/compose/keycloak.env up --build
#
# Variables are substituted into the Compose file via ${VAR:-default} syntax.
# Uncomment and set any variable you need to override.

# Host-facing ports — change these if 3010 or 3001 conflict with other services.
# IMPORTANT: If you change GATEWAY_PORT, you must also update "included.custom.audience" in
# deploy/keycloak/infra-gate-realm.json to match http://127.0.0.1:<GATEWAY_PORT>/mcp,
# then re-import the realm. Keycloak bakes the audience into tokens at import time.
# GATEWAY_PORT=3001
# KEYCLOAK_PORT=3010

# Keycloak admin credentials (default: admin/admin).
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# Path to a kubeconfig for the MCP server inside the gateway container.
# If you override this, you must also add a matching Docker Compose volume mount
# that maps the host-side kubeconfig file into the container.
# KUBECONFIG=/run/kube/my-custom.config
