# Docker Compose interpolation values.
INFRA_GATE_GATEWAY_IMAGE=ghcr.io/mirusser/kubernetes-mcp-guard-gateway
INFRA_GATE_BIND_ADDRESS=127.0.0.1
INFRA_GATE_BIND_PORT=3001
INFRA_GATE_KUBECONFIG_HOST_PATH=/etc/infra-gate/production.kubeconfig
INFRA_GATE_APPROVAL_HOST_PATH=/var/lib/infra-gate/production/approvals
INFRA_GATE_GUARD_AUDIT_HOST_PATH=/var/lib/infra-gate/production/guardrails

# Gateway and downstream server runtime values.
INFRA_GATE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:3001
INFRA_GATE_DOWNSTREAM_ASSEMBLY=/app/server/InfraGate.McpServer.dll
INFRA_GATE_OAUTH_AUTHORITY=https://issuer.example.com/realms/infra-gate
INFRA_GATE_OAUTH_RESOURCE=https://gateway.example.com/mcp
INFRA_GATE_OAUTH_SCOPE=mcp:tools
INFRA_GATE_OAUTH_REQUIRE_HTTPS_METADATA=true
INFRA_GATE_APPROVAL_BASE_URL=https://gateway.example.com
INFRA_GATE_APPROVAL_OAUTH_CLIENT_ID=infra-gate-approval-ui
INFRA_GATE_APPROVAL_OAUTH_CALLBACK_PATH=/approvals/oauth/callback
INFRA_GATE_APPROVAL_OAUTH_AUTHORIZATION_ENDPOINT=https://issuer.example.com/realms/infra-gate/protocol/openid-connect/auth
INFRA_GATE_APPROVAL_OAUTH_TOKEN_ENDPOINT=https://issuer.example.com/realms/infra-gate/protocol/openid-connect/token
INFRA_GATE_GUARD_AUDIT_ROOT=/data/guardrails
KUBECONFIG=/run/kube/infra-gate.config
K8S_MCP_APPROVAL_ROOT=/data/approvals
K8S_MCP_ALLOWED_NAMESPACES=mcp-nginx-demo
