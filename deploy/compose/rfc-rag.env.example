# deploy/compose/rfc-rag.env.example
# Copy to .env.rfc-rag and edit, then run:
#   docker compose --env-file .env.rfc-rag -f deploy/compose/rfc-rag.yaml up
#
# This file serves both as compose interpolation source (--env-file) and
# as the container env_file for both services. Each variable goes to the
# container that needs it; unused vars are harmless.
#
# ── Required ──────────────────────────────────────────────────────────

# OpenRouter API key for embedding generation during RFC indexing.
# Leave empty to skip indexing (search already-indexed data still works).
InfraGate__OpenRouter__ApiKey="sk-or-..."
OPENROUTER_API_KEY="sk-or-..."

# ── PostgreSQL (postgres service) ─────────────────────────────────────

# These vars are read by the postgres container on first start.
POSTGRES_DB=rfc_rag
POSTGRES_USER=rfc_rag
POSTGRES_PASSWORD=rfc-rag-dev-password

# Also used by compose interpolation (healthcheck, connection string). Must
# match the POSTGRES_* values above.
PG_DATABASE=rfc_rag
PG_USER=rfc_rag
PG_PASSWORD=rfc-rag-dev-password

# ── RFC RAG (rfc-rag service) ─────────────────────────────────────────

# Connection string for the rfc-rag app. Must match the PG_* / POSTGRES_*
# values above.
InfraGate__RfcRag__PostgresConnectionString="Host=postgres;Port=5432;Database=rfc_rag;Username=rfc_rag;Password=rfc-rag-dev-password"

# Container-internal path to the RFC mirror (bind-mounted from the host).
InfraGate__RfcRag__RfcMirrorPath=/rfc-mirror

# ── Optional: compose interpolation only ──────────────────────────────

# Postgres bind address and port on the host (defaults: 127.0.0.1:5433).
PG_BIND_ADDRESS=127.0.0.1
PG_BIND_PORT=5433

# Host path to RFC mirror directory (default: ~/rfc-mirror).
RFC_MIRROR_HOST_PATH=/home/user/rfc-mirror

# Host path for PostgreSQL data persistence (default: ./pgdata relative to cwd).
PG_DATA_HOST_PATH=./pgdata

# Path to the env_file (default: ../../.env.rfc-rag relative to compose file).
# Only needed if the env file is at a non-default location.
# RFC_RAG_ENV_FILE=/custom/path.env
